# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_PROJECT_REF=your-project-ref

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# For production, use live keys:
# STRIPE_SECRET_KEY=sk_live_your_live_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_key

# App Configuration
APP_URL=http://localhost:3000
APP_ENVIRONMENT=development  # Change to 'production' for live environment

# Creator Plans
CREATOR_BASIC_PLAN_ID=price_your_stripe_price_id
CREATOR_PRO_PLAN_ID=price_your_stripe_price_id
CREATOR_PREMIUM_PLAN_ID=price_your_stripe_price_id

# Brand Plans
BRAND_BASIC_PLAN_ID=price_your_stripe_price_id
BRAND_PRO_PLAN_ID=price_your_stripe_price_id
BRAND_PREMIUM_PLAN_ID=price_your_stripe_price_id

# Environment Variables
VITE_USE_MOCK_DATA=true

# Stripe (Frontend mock mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Paywall settings
VITE_USE_MOCK_PAYWALL=true

# To connect to a real backend, use these variables:
# VITE_USE_MOCK_DATA=false
# VITE_API_URL=https://your-api-url.com
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_real_key

# Environment Variables - EXAMPLE FILE
# Copy this file to .env and fill in your actual values

# Mock Data (set to false for production)
VITE_USE_MOCK_DATA=true

# Stripe (Frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Success and cancel URLs
VITE_PAYMENT_SUCCESS_URL=/payment-success
VITE_PAYMENT_CANCEL_URL=/payment-cancel

# Paywall settings
VITE_USE_MOCK_PAYWALL=true

# Supabase
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# For Supabase Functions (.env.local)
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key 